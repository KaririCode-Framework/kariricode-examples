[APP_ENV]
required = true
allowed = local, staging, production, test

[APP_DEBUG]
required = true
type = boolean

[APP_PORT]
required = true
type = integer
min = 1
max = 65535

[DB_HOST]
required = true
notEmpty = true

[DB_PORT]
required = true
type = integer
min = 1
max = 65535

[DB_POOL_SIZE]
required = true
type = integer
min = 1
max = 100

[API_TIMEOUT]
required = true
type = integer
min = 1
max = 300

[API_RATE_LIMIT]
required = true
type = integer
min = 1
max = 10000
