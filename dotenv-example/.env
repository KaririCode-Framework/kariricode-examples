# ─────────────────────────────────────────────────────────────────────────────
#  kariricode-dotenv Example Project — Main Environment File
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="KaririCode Dotenv Example"
APP_ENV=local
APP_DEBUG=true
APP_VERSION=4.0.0
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kariricode_db
DB_USER=admin
DB_PASSWORD=s3cr3t!
DB_POOL_SIZE=10

# Cache
CACHE_TTL=3600
CACHE_ENABLED=true

# API
API_KEY=abc123def456
API_TIMEOUT=30
API_RATE_LIMIT=100

# Numeric types
MAX_UPLOAD_MB=50
PI_VALUE=3.14159
SCORE=9.8

# Null / boolean coercion
FEATURE_FLAG=true
MAINTENANCE_MODE=false
NULLABLE_VAR=null

# Array / JSON
ALLOWED_IPS=192.168.1.1,10.0.0.1,127.0.0.1
JSON_CONFIG={"theme":"dark","lang":"pt-BR","items":42}

# Variable interpolation
BASE_URL=https://api.example.com
HEALTH_ENDPOINT=${BASE_URL}/health
AUTH_ENDPOINT=${BASE_URL}/auth/token
FALLBACK_URL=${MISSING_VAR:-https://fallback.example.com}

# Base64 encoded
ENCODED_SECRET=SGVsbG8gZnJvbSBLYXJpcmlDb2RlIQ==

# URL for normalization
APP_WEBHOOK_URL=https://hooks.example.com/webhook/  
