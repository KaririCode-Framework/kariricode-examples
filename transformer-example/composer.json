{
    "name": "kariricode/transformer-example",
    "description": "Real-world examples for the kariricode/transformer library — ARFA 1.3 / Spec V4.0 (library: v2.0.0)",
    "type": "project",
    "require": {
        "php": "^8.4",
        "kariricode/transformer": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../kariricode-transformer",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
